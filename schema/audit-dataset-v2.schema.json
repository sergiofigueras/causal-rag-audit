{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sergiofigueras/causal-rag-audit/schema/audit-dataset-v2.schema.json",
  "title": "CEA-Extended audit dataset v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "cases"],
  "properties": {
    "schema_version": {"const": 2},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "abstention_answers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "metadata": {"type": "object"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "metadata": {"type": "object"}
      }
    },
    "proof": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "documents", "expected_answer", "proof_sets", "changed_document_ids", "removed_document_ids", "rationale"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "family": {"enum": ["baseline", "counterfactual", "nuisance", "ablation", "redundancy", "conflict"]},
        "documents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/document"}},
        "expected_answer": {"type": ["string", "null"]},
        "answer_aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "proof_sets": {"type": "array", "items": {"$ref": "#/$defs/proof"}},
        "changed_document_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "removed_document_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rationale": {"type": "string", "minLength": 1},
        "resolution_policy": {"enum": ["authority", "abstain"]},
        "authority_document_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "if": {"properties": {"family": {"const": "conflict"}}},
      "then": {"required": ["resolution_policy"]},
      "else": {"not": {"anyOf": [{"required": ["resolution_policy"]}, {"required": ["authority_document_ids"]}]}}
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "conditions"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "conditions": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/condition"}},
        "metadata": {"type": "object"}
      }
    }
  }
}
